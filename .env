# RESQ-NET Configuration
PROJECT_NAME="RESQ-NET Disaster-Resilient Emergency Communication System"
VERSION="1.0.0"

# Database: SQLite for zero-config local run, or PostgreSQL
DATABASE_URL="sqlite:///./resqnet.db"

# JWT Security
SECRET_KEY="resqnet-disaster-resilient-emergency-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMS Gateway Integration Shared Secret
GATEWAY_API_KEY="resqnet-gateway-token-secret"

# AI Integration - Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Default Geographic Coordinates
DEFAULT_LAT=17.7234
DEFAULT_LNG=83.3012
